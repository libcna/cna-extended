# Generated API-reference configuration for the cna-extended documentation site.
# Run from web/. Input is the repository's public include tree; output is web/reference/.

PROJECT_NAME           = "cna-extended API Reference"
PROJECT_BRIEF          = "C++23 2D and 3D game-development toolkit for CNA"
OUTPUT_DIRECTORY       = reference
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE         = English

INPUT                  = ../include
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp
EXCLUDE_PATTERNS       = */vendor/*
STRIP_FROM_PATH        = ../include
STRIP_FROM_INC_PATH    = ../include
FULL_PATH_NAMES        = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INHERIT_DOCS           = YES
INLINE_INHERITED_MEMB  = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = LIGHT
HTML_DYNAMIC_MENUS     = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
HTML_EXTRA_STYLESHEET  = reference-theme.css

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
QUIET                  = YES
